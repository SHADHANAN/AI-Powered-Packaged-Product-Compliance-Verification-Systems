        "mfg_date": "08/2026",
        "customer_care": "1800-000-111",
        "country_of_origin": "India"
      },
      "expected": {
        "overall_status": "NON_COMPLIANT",
        "risk_level": "HIGH",
        "failed": 1,
        "rule_statuses": {
          "LM005": "FAIL"
        }
      }
    },
    {
