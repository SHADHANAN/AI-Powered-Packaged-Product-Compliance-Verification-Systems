# Application Settings
APP_NAME="AI-Powered Packaged Product Compliance Verification System"
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server Settings
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# CORS Settings (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Settings
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/product_compliance

# JWT Authentication Settings
JWT_SECRET_KEY=change-this-in-production-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
